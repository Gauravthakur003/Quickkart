# SQL Server connection
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=QuickKartDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=replace-with-your-local-sql-server-password

# Change both values before using the application outside local development
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000

# Admin account created automatically on first backend startup
APP_ADMIN_EMAIL=admin@quickkart.local
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

FRONTEND_URL=http://localhost:5173
SERVER_PORT=8080
